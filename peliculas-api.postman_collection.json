{
  "info": {
    "name": "API Películas — Semana 7",
    "description": "Colección de Postman para documentar y probar la API de películas completa del lab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Admin\",\n  \"email\": \"admin@cine.com\",\n  \"password\": \"admin123\",\n  \"rol\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "registro"]
            },
            "description": "Registra un usuario nuevo y devuelve un JWT."
          }
        },
        {
          "name": "POST login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json()",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token)",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cine.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Inicia sesión y guarda automáticamente el token en la variable de colección."
          }
        },
        {
          "name": "GET perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/perfil",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "perfil"]
            },
            "description": "Devuelve el perfil del usuario autenticado."
          }
        }
      ]
    },
    {
      "name": "Películas",
      "item": [
        {
          "name": "GET listar películas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/peliculas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas"]
            },
            "description": "Devuelve el listado de películas con paginación."
          }
        },
        {
          "name": "GET listar con filtro por género",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/peliculas?genero=drama&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas"],
              "query": [
                {
                  "key": "genero",
                  "value": "drama"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Devuelve películas filtradas por género."
          }
        },
        {
          "name": "GET detalle película",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/peliculas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas", "1"]
            },
            "description": "Devuelve una película por ID, incluyendo reseñas y conteo de favoritos."
          }
        },
        {
          "name": "POST crear película",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Arrival\",\n  \"anio\": 2016,\n  \"nota\": 7.9,\n  \"director\": \"Denis Villeneuve\",\n  \"genero\": \"ciencia-ficcion\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/peliculas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas"]
            },
            "description": "Crea una película. Requiere usuario autenticado."
          }
        },
        {
          "name": "PUT actualizar película",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Arrival actualizada\",\n  \"nota\": 8.1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/peliculas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas", "1"]
            },
            "description": "Actualiza una película existente. Requiere rol admin."
          }
        },
        {
          "name": "DELETE eliminar película",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/peliculas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas", "1"]
            },
            "description": "Elimina una película existente. Requiere rol admin."
          }
        },
        {
          "name": "GET reseñas de película",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/peliculas/1/resenas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas", "1", "resenas"]
            },
            "description": "Devuelve las reseñas asociadas a una película."
          }
        },
        {
          "name": "POST crear reseña",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"autor\": \"Marco\",\n  \"texto\": \"Buena película para probar el endpoint de reseñas.\",\n  \"puntuacion\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/peliculas/1/resenas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peliculas", "1", "resenas"]
            },
            "description": "Crea una reseña para una película. Requiere autenticación."
          }
        }
      ]
    },
    {
      "name": "IA",
      "item": [
        {
          "name": "POST recomendar ciencia ficción",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"generos\": [\"ciencia-ficcion\"],\n  \"nota_minima\": 7.5,\n  \"limite\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ia/recomendar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ia", "recomendar"]
            },
            "description": "Devuelve recomendaciones de películas en formato estructurado para IA."
          }
        },
        {
          "name": "POST recomendar con exclusiones",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"generos\": [\"ciencia-ficcion\", \"drama\"],\n  \"nota_minima\": 7.5,\n  \"excluir_ids\": [1, 3],\n  \"limite\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ia/recomendar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ia", "recomendar"]
            },
            "description": "Ejemplo de recomendación con varios filtros y películas excluidas."
          }
        }
      ]
    }
  ]
}
